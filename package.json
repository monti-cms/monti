{
	"name": "monti",
	"private": true,
	"license": "MIT",
	"scripts": {
		"test": "pnpm --filter @monti-cms/core --filter @monti-cms/cli --filter @monti-cms/http --filter @monti-cms/storage-s3 --fail-if-no-match test",
		"typecheck": "pnpm --filter @monti-cms/core --filter @monti-cms/cli --filter @monti-cms/http --filter @monti-cms/storage-s3 --fail-if-no-match exec tsc --noEmit",
		"lint": "pnpm exec biome check . && pnpm lint:secrets && pnpm lint:deps && pnpm lint:unused && pnpm lint:dup",
		"lint:secrets": "secretlint \"packages/**\" \"scripts/**\"",
		"lint:deps": "pnpm --filter @monti-cms/core --filter @monti-cms/cli --filter @monti-cms/http --filter @monti-cms/storage-s3 --fail-if-no-match lint:deps",
		"lint:unused": "pnpm --filter @monti-cms/core --filter @monti-cms/cli --filter @monti-cms/http --filter @monti-cms/storage-s3 --fail-if-no-match lint:unused",
		"lint:dup": "pnpm --filter @monti-cms/core --filter @monti-cms/cli --filter @monti-cms/http --filter @monti-cms/storage-s3 --fail-if-no-match lint:dup",
		"lint:fix": "pnpm exec biome check . --write",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@monti-cms/admin": "workspace:*",
		"@monti-cms/core": "workspace:*",
		"@secretlint/secretlint-rule-pattern": "^13.1.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dependency-cruiser": "^18.8.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.3",
		"knip": "^6.46.0",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.28",
		"react": "^19",
		"react-dom": "^19",
		"secretlint": "^14.0.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
