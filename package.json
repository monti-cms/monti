{
	"name": "monti",
	"private": true,
	"license": "MIT",
	"scripts": {
		"lint": "pnpm exec biome check .",
		"lint:fix": "pnpm exec biome check . --write",
		"gen:tokens": "node scripts/gen-tokens.mjs",
		"gen:screen-catalog": "node scripts/gen-screen-catalog.mjs",
		"check:korean": "node scripts/check-korean.mjs",
		"check:design": "node scripts/check-design.mjs",
		"check:review": "node scripts/check-review.mjs",
		"test:scripts": "node --test scripts/check-review.test.mjs scripts/merge-commands.test.mjs scripts/check-scenes.test.mjs scripts/build-styles.test.mjs scripts/check-banner-place.test.mjs scripts/check-screens.test.mjs scripts/pack-release.test.mjs scripts/check-test-titles.test.mjs scripts/check-typed-marks.test.mjs scripts/check-operations.test.mjs",
		"check:screens": "node scripts/check-screens.mjs",
		"check:scenes": "node scripts/check-scenes.mjs",
		"check:titles": "node scripts/check-test-titles.mjs",
		"check:messages": "node scripts/check-messages.mjs",
		"check:packages": "node scripts/check-packages.mjs",
		"try:release": "node scripts/try-release.mjs",
		"typecheck": "pnpm --filter \"./packages/*\" --filter \"./examples/*\" -r typecheck && tsc --noEmit -p testing/e2e",
		"build": "pnpm --filter @monti-cms/core build && pnpm --filter @monti-cms/ui build && pnpm --filter @monti-cms/admin build && pnpm --filter @monti-cms/ai build && pnpm --filter @monti-cms/storage-s3 build && pnpm --filter @monti-cms/seo build && pnpm --filter @monti-cms/mdx build && pnpm --filter @monti-cms/next build",
		"prepare": "husky",
		"knip": "knip --include files,exports,types,duplicates && knip --production --include exports,types",
		"check:operations": "node scripts/check-operations.mjs",
		"test": "pnpm --filter @monti-cms/core --filter @monti-cms/ai --filter @monti-cms/admin --filter @monti-cms/next --filter @monti-cms/storage-s3 --filter @monti-cms/seo --filter @monti-cms/mdx test",
		"test:browser": "pnpm --filter @monti-cms/ui test:browser && pnpm --filter @monti-cms/admin test:screen",
		"test:e2e": "tsx testing/e2e/prepare.ts && playwright test --config testing/e2e/playwright.config.ts",
		"usability:server": "tsx testing/e2e/prepare.ts --seed monti_usability 4173",
		"usability:files": "node testing/usability/files.ts",
		"usability:driver": "node testing/usability/driver.ts http://localhost:4173"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@monti-cms/admin": "workspace:*",
		"@monti-cms/core": "workspace:*",
		"@playwright/test": "1.64.1",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/browser-playwright": "4.1.12",
		"husky": "^9.1.7",
		"knip": "^6.41.0",
		"kysely": "^0.29.6",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"oxc-parser": "0.153.0",
		"pg": "^8.23.0",
		"playwright": "1.64.1",
		"playwright-core": "1.64.1",
		"postcss": "^8.5.28",
		"publint": "^0.3.25",
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "4.1.12"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
