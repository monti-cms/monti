{
	"name": "monti",
	"private": true,
	"license": "MIT",
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"lint": "pnpm exec biome check .",
		"lint:fix": "pnpm exec biome check . --write",
		"check:korean": "node scripts/check-korean.mjs",
		"typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
		"build": "pnpm --filter @monti-cms/core build && pnpm --filter @monti-cms/mdx build && pnpm --filter @monti-cms/syntax-directive build && pnpm --filter @monti-cms/syntax-shiki build && pnpm --filter @monti-cms/admin build && pnpm --filter @monti-cms/nextjs build && pnpm --filter @monti-cms/ai build && pnpm --filter @monti-cms/blocks build && pnpm --filter @monti-cms/bareun build && pnpm --filter @monti-cms/seo build",
		"example:check": "node scripts/check-example.mjs",
		"example:pack": "node scripts/pack-example.mjs",
		"preview:example": "node scripts/preview-example.mjs",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/node": "^20",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
