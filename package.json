{
	"name": "monti",
	"private": true,
	"license": "MIT",
	"scripts": {
		"lint": "pnpm exec biome check .",
		"lint:fix": "pnpm exec biome check . --write",
		"gen:tokens": "node scripts/gen-tokens.mjs",
		"gen:screen-catalog": "node scripts/gen-screen-catalog.mjs",
		"check:korean": "node scripts/check-korean.mjs",
		"check:design": "node scripts/check-design.mjs",
		"check:screens": "node scripts/check-screens.mjs",
		"check:messages": "node scripts/check-messages.mjs",
		"typecheck": "pnpm --filter \"./packages/*\" -r typecheck",
		"build": "pnpm --filter @monti-cms/core build && pnpm --filter @monti-cms/ui build",
		"prepare": "husky",
		"knip": "knip --include files,exports,types,duplicates && knip --production --include exports,types",
		"check:operations": "node scripts/check-operations.mjs",
		"test": "pnpm --filter @monti-cms/core test"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^20",
		"husky": "^9.1.7",
		"knip": "^6.41.0",
		"lightningcss": "^1.33.0",
		"lint-staged": "^17.6.0",
		"playwright-core": "1.64.1",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
