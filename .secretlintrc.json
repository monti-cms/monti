{
	"rules": [
		{
			"id": "@secretlint/secretlint-rule-preset-recommend"
		},
		{
			"id": "@secretlint/secretlint-rule-pattern",
			"options": {
				"patterns": [
					{
						"name": "database connection URL",
						"patterns": ["/(?:postgres|postgresql|mysql|mongodb(?:\\+srv)?|redis|rediss):\\/\\/[^\\s\"'`]+/gi"]
					}
				]
			}
		}
	]
}
