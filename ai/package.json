{
  "name": "@monti-cms/ai",
  "version": "0.2.0-next.1",
  "private": true,
  "description": "AI plugin for @monti-cms/core: named AI actions, a decision model (System One), and the admin AI screen",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": "./dist/server.browser.js",
      "default": "./dist/server.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.61",
    "ai": "^7.0.124",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "lucide-react": ">=0.562.0",
    "react": ">=19",
    "sonner": "^2.0.8",
    "@monti-cms/admin": "^0.2.0-next.1",
    "@monti-cms/core": "^0.2.0-next.1",
    "@monti-cms/mdx": "^0.2.0-next.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18",
    "@monti-cms/core": "0.2.0-next.1",
    "@monti-cms/admin": "0.2.0-next.1",
    "@monti-cms/mdx": "0.2.0-next.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
    "test:other-site": "vitest run -c vitest.othersite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "node ../../scripts/build-package.mjs"
  }
}