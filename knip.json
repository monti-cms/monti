{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"scripts/test-metrics/*.mjs",
				"flows/playwright.config.ts",
				"flows/*.flow.ts",
				"flows/overlay/**/*.ts"
			]
		},
		"packages/ui": {
			"entry": ["visual/playwright.config.ts", "visual/audit.config.ts", "visual/*.spec.ts"]
		},
		"packages/admin": {
			"entry": [
				"src/**/*.test.{ts,tsx}",
				"src/**/__test__/**/*.{ts,tsx}",
				"vitest.mutation.config.ts",
				"src/test/core-routes.browser.ts"
			],
			"ignoreIssues": {
				"src/ui/**": ["exports", "types"]
			}
		},
		"packages/ai": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}", "src/routes/**/route.ts!"]
		},
		"packages/seo": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/blocks": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/core": {
			"entry": [
				"src/**/*.test.{ts,tsx}",
				"src/**/__test__/**/*.{ts,tsx}",
				"src/http/**/route.ts!",
				"test/**/*.{ts,tsx}",
				"vitest.mutation.config.ts"
			]
		},
		"packages/nextjs": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/mdx": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/auth": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/storage-s3": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/syntax-directive": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		},
		"packages/syntax-shiki": {
			"entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"]
		}
	},
	"ignoreExportsUsedInFile": true,
	"ignore": ["examples/**", "packages/*/src/**/__test__/fixtures/**", ".claude/**"]
}
