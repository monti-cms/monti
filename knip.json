{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		"packages/admin": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"] },
		"packages/ai": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}", "src/routes/**/route.ts"] },
		"packages/git-sync": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"] },
		"packages/seo": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"] },
		"packages/bareun": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"] },
		"packages/blocks": { "entry": ["src/**/*.test.{ts,tsx}", "src/**/__test__/**/*.{ts,tsx}"] }
	},
	"ignoreExportsUsedInFile": true
}
