{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/*.mjs"]
		},
		"packages/admin": {
			"ignoreIssues": {
				"src/ui/**": ["exports", "types"]
			}
		},
		"packages/ai": {
			"entry": ["src/routes/**/route.ts!"]
		},
		"packages/core": {
			"entry": ["src/http/**/route.ts!"]
		},
		"packages/ui": {
			"entry": ["src/spec-pack/pack.mjs"],
			"ignoreIssues": {
				"src/spec-pack/parts.tsx": ["exports"]
			}
		}
	},
	"ignoreExportsUsedInFile": true,
	"ignore": ["examples/**", "packages/mdx/src/__test__/fixtures/**"]
}
