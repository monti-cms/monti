{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"testing/scenes.ts",
				"testing/e2e/*.e2e.ts",
				"testing/e2e/playwright.config.ts",
				"testing/e2e/hook.ts",
				"testing/usability/do.ts"
			],
			"ignore": ["testing/release/app/**"]
		},
		"packages/admin": {
			"entry": ["styles/index.css"]
		},
		"packages/core": {
			"entry": ["src/**/*.test.ts", "src/__test__/**"]
		},
		"packages/ai": {
			"entry": ["src/**/*.test.ts"]
		},
		"packages/storage-s3": {
			"entry": ["src/**/*.test.ts"]
		},
		"packages/seo": {
			"entry": ["src/**/*.test.ts"]
		},
		"packages/mdx": {
			"entry": ["src/**/*.test.ts"]
		},
		"examples/showcase": {
			"entry": ["seed/seed.ts"]
		},
		"packages/ui": {
			"entry": ["src/spec-pack/pack.mjs"],
			"ignoreIssues": {
				"src/spec-pack/parts.tsx": ["exports"]
			}
		}
	},
	"ignoreExportsUsedInFile": true
}
