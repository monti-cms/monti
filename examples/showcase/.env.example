# Postgres. Make the tables once with `pnpm db:setup`, then fill them with `pnpm seed`.
DATABASE_URL=postgres://localhost/monti_showcase
# Signs preview links. Any long random text.
MONTI_SECRET=change-me

# Where this site runs, for the hooks it posts to itself (`/hooks/ok`, `/hooks/broken`).
# SHOWCASE_URL=http://localhost:3000
# A webhook that works: every event is posted here. `/hooks/ok` of this site keeps the last 20 (open it to see them).
# MONTI_WEBHOOK=http://localhost:3000/hooks/ok
# `off` leaves out the hook that fails on purpose.
# SHOWCASE_BROKEN_HOOK=off

# Media files. Left as they are, they go to `.monti/files` in this folder (`MONTI_FILES` moves it); `MONTI_STORAGE=off` runs with
# no storage. With `S3_BUCKET` set they go to S3, R2 or MinIO (see packages/storage-s3/README.md), and the bucket's CORS must take a
# `PUT` from http://localhost:3000 (`pnpm exec monti doctor --origin http://localhost:3000` checks it).
# MONTI_FILES=/path/to/files
# MONTI_STORAGE=off
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.dev
# S3_REGION=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=

# The assistant's keys are not here: add them in the admin, under Tools › API keys.
