# Postgres. Make the tables once with `pnpm db:setup`.
DATABASE_URL=postgres://localhost/monti_blog
# Signs preview links. Any long random text.
MONTI_SECRET=change-me
# Optional: an address every event is posted to (a search index, a deploy hook).
# MONTI_WEBHOOK=https://example.dev/api/hook
# Where the site is on the web, for the addresses its pages name whole (canonical, the other languages'). `monti doctor` reads it too.
# SITE_URL=https://example.dev
