# Postgres connection URL
DATABASE_URL=postgres://user:password@localhost:5432/cms
# Schema name when the database is shared (public if empty)
# DATABASE_SCHEMA=
# Any long random value, e.g. `openssl rand -base64 32`. Signs login sessions and encrypts stored values (AI service keys, git-sync tokens)
MONTI_SECRET=
# GitHub login for production (`next dev` signs you in as the admin without these). OAuth app callback URL: http://localhost:3000/api/cms/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub id of the admin
MONTI_ADMIN_GITHUB_ID=
# Public URL of the site (links in bodies written as full URLs count as internal links)
# SITE_URL=
# Only behind a proxy you run yourself (nginx, a load balancer): true. Vercel, Netlify and Cloudflare Pages are detected
# AUTH_TRUST_HOST=true
