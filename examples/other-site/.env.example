CMS_DATABASE_URL=postgres://user:password@localhost:5432/cms
# 같은 DB를 나눠 쓸 때 스키마 이름(없으면 public)
CMS_SCHEMA=
# 임의의 긴 값(로그인 세션 서명)
AUTH_SECRET=
# 임의의 긴 값, AUTH_SECRET과 다르게(저장 값 암호화. 바꾸면 저장한 AI 서비스 키를 다시 넣는다)
CMS_SECRET=
# 로컬 개발에서 로그인 없이 관리자로 본다(next dev에서만)
CMS_DEV_AUTH_BYPASS=1
# GitHub 로그인. OAuth 앱 콜백 주소: http://localhost:3000/api/cms/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
CMS_ADMIN_GITHUB_ID=
