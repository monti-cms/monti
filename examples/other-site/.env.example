CMS_DATABASE_URL=postgres://user:password@localhost:5432/cms
# Schema name when sharing the same DB (defaults to public)
CMS_SCHEMA=
# Any long random value (signs login sessions)
AUTH_SECRET=
# Any long random value, different from AUTH_SECRET (encrypts stored values; if you change it, re-enter the saved AI service keys)
CMS_SECRET=
# Treat requests from this machine as admin without logging in during local development (next dev only)
CMS_DEV_AUTH_BYPASS=1
# GitHub login. OAuth app callback URL: http://localhost:3000/api/cms/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
CMS_ADMIN_GITHUB_ID=
# Set to true behind a proxy or on a platform such as Vercel that sets Host and X-Forwarded-Host (login in production)
# AUTH_TRUST_HOST=true
