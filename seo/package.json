{
  "name": "@monti-cms/seo",
  "version": "0.2.0-next.0",
  "private": true,
  "description": "SEO extension for @monti-cms/core: search and share field set, search preview, AI suggestions for search title and description, public page helper",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "@monti-cms/core": "^0.2.0-next.0",
    "@monti-cms/admin": "^0.2.0-next.0",
    "@monti-cms/ai": "^0.2.0-next.0"
  },
  "peerDependenciesMeta": {
    "@monti-cms/ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^27.4.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18",
    "@monti-cms/core": "0.2.0-next.0",
    "@monti-cms/ai": "0.2.0-next.0",
    "@monti-cms/admin": "0.2.0-next.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "node ../../scripts/build-package.mjs"
  }
}