    "@shikijs/transformers": "^3.22.0",
    "@types/hast": "^3.0.4",
    "@types/pg": "^8.23.1",
    "@types/unist": "^3.0.3",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
