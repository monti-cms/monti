		"./styles.css": "./styles.css"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
		"test:other-site": "vitest run -c vitest.othersite.config.ts",
		"typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.other-site.json",
		"build": "node ../../scripts/build-package.mjs"
