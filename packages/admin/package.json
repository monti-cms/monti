	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@tanstack/react-query": "^5.104.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@types/node": "^20",
