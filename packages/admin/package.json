{
	"name": "@monti-cms/admin",
	"version": "0.2.0-next.2",
	"private": true,
	"description": "Admin UI for @monti-cms/core: editor, lists, media, templates, and plugin extension points. Framework-neutral: a host package (@monti-cms/nextjs) supplies the router",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./host": "./src/host/index.tsx",
		"./router": "./src/router/index.tsx",
		"./editor": "./src/editor/public.ts",
		"./blocks": "./src/editor/blocks/public.ts",
		"./hooks": "./src/hooks/public.ts",
		"./plugins": "./src/plugins.ts",
		"./media": "./src/media.ts",
		"./slots": "./src/slots/slots.tsx",
		"./api": "./src/screens/admin-api.ts",
		"./kit": "./src/kit.ts",
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
		"test:other-site": "vitest run -c vitest.othersite.config.ts",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs && node ../../scripts/build-styles.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@tanstack/react-table": "^9.2.4",
		"@tiptap/extension-code-block": "^3.31.3",
		"@tiptap/extension-list": "^3.31.3",
		"@tiptap/extension-subscript": "^3.31.3",
		"@tiptap/extension-superscript": "^3.31.3",
		"@tiptap/extension-table": "^3.31.3",
		"@tiptap/extension-text-align": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"katex": "^0.16.45",
		"react-day-picker": "^10.0.1",
		"server-only": "^0.0.1",
		"shiki": "^3.21.0",
		"tailwind-merge": "^3.4.0",
		"zustand": "^5.0.15"
	},
	"peerDependencies": {
		"@monti-cms/core": "workspace:^",
		"@tanstack/react-query": "^5.104.0",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"lucide-react": ">=0.562.0",
		"next-themes": ">=0.4",
		"react": ">=19",
		"react-dom": ">=19",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@tanstack/react-query": "^5.104.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jsdom": "^27.4.0",
		"lucide-react": "^0.562.0",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"sonner": "^2.0.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./host": {
				"types": "./dist/host/index.d.ts",
				"default": "./dist/host/index.js"
			},
			"./router": {
				"types": "./dist/router/index.d.ts",
				"default": "./dist/router/index.js"
			},
			"./editor": {
				"types": "./dist/editor/public.d.ts",
				"default": "./dist/editor/public.js"
			},
			"./blocks": {
				"types": "./dist/editor/blocks/public.d.ts",
				"default": "./dist/editor/blocks/public.js"
			},
			"./hooks": {
				"types": "./dist/hooks/public.d.ts",
				"default": "./dist/hooks/public.js"
			},
			"./plugins": {
				"types": "./dist/plugins.d.ts",
				"default": "./dist/plugins.js"
			},
			"./media": {
				"types": "./dist/media.d.ts",
				"default": "./dist/media.js"
			},
			"./slots": {
				"types": "./dist/slots/slots.d.ts",
				"default": "./dist/slots/slots.js"
			},
			"./api": {
				"types": "./dist/screens/admin-api.d.ts",
				"default": "./dist/screens/admin-api.js"
			},
			"./kit": {
				"types": "./dist/kit.d.ts",
				"default": "./dist/kit.js"
			},
			"./styles.css": "./dist/styles.css"
		}
	}
}
