{
	"name": "@monti-cms/admin",
	"version": "0.1.0",
	"private": true,
	"description": "@monti-cms/core의 관리자 화면(Next.js): 편집기·목록·미디어·템플릿, 플러그인 확장점",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./next": "./src/next/index.tsx",
		"./editor": "./src/editor/public.ts",
		"./blocks": "./src/editor/blocks/public.ts",
		"./plugins": "./src/plugins.ts",
		"./media": "./src/media.ts",
