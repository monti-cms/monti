{
	"name": "@monti-cms/admin",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's admin screens: they reach the server only through operations",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"build:styles": "node ../../scripts/build-styles.mjs",
		"storybook": "storybook dev -p 6007 --no-open",
		"build-storybook": "storybook build -o storybook-static",
		"test": "vitest run --project admin",
		"test:screen": "vitest run --project 'admin (screen)'",
		"build": "node ../../scripts/build-package.mjs && node ../../scripts/build-styles.mjs"
	},
	"dependencies": {
		"@monti-cms/ai": "workspace:*",
		"@monti-cms/core": "workspace:*",
		"@monti-cms/ui": "workspace:*",
		"@tiptap/core": "3.31.3",
		"@tiptap/extension-bold": "3.31.3",
		"@tiptap/extension-code": "3.31.3",
		"@tiptap/extension-document": "3.31.3",
		"@tiptap/extension-hard-break": "3.31.3",
		"@tiptap/extension-italic": "3.31.3",
		"@tiptap/extension-link": "3.31.3",
		"@tiptap/extension-strike": "3.31.3",
		"@tiptap/extension-subscript": "3.31.3",
		"@tiptap/extension-superscript": "3.31.3",
		"@tiptap/extension-table": "3.31.3",
		"@tiptap/extension-text": "3.31.3",
		"@tiptap/extension-underline": "3.31.3",
		"@tiptap/extensions": "3.31.3",
		"@tiptap/pm": "3.31.3",
		"@tiptap/react": "3.31.3"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.15",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@monti-cms/mdx": "workspace:*",
		"@monti-cms/seo": "workspace:*",
		"@storybook/addon-themes": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"kysely": "^0.29.6",
		"pretendard": "^1.3.9",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"storybook": "10.6.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "4.1.12"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./styles.css": "./dist/styles.css"
		}
	}
}
