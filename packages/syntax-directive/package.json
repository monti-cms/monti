{
	"name": "@monti-cms/syntax-directive",
	"version": "0.2.0-next.0",
	"private": true,
	"description": "Directive syntax extension for @monti-cms/mdx: read and write :::callout, ::image{…} and :u[text] in MDX bodies",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts && vitest run -c vitest.configured.config.ts",
		"test:other-site": "vitest run -c vitest.othersite.config.ts",
		"test:configured": "vitest run -c vitest.configured.config.ts",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"@types/mdast": "^4.0.4",
		"remark-directive": "^4.0.0",
		"unist-util-visit": "^5.0.0",
		"vfile": "^6.0.3"
	},
	"peerDependencies": {
		"@monti-cms/mdx": "workspace:^"
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@monti-cms/mdx": "workspace:*",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"next": "16.4.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"remark-gfm": "^4.0.1",
		"remark-mdx": "^3.1.1",
		"remark-parse": "^11.0.0",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
