{
	"name": "@monti-cms/seo",
	"version": "0.1.0",
	"private": true,
	"cmsPlugin": true,
	"description": "SEO extension for @monti-cms/core: search and share field set, search preview, AI suggestions for search title and description, public page helper",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.ts",
		"./styles.css": "./styles.css"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
		"typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.other-site.json",
		"build": "node ../../scripts/build-package.mjs"
	},
	"peerDependencies": {
		"@monti-cms/core": "workspace:^",
		"@monti-cms/admin": "workspace:^",
		"@monti-cms/ai": "workspace:^",
		"react": ">=19"
	},
	"peerDependenciesMeta": {
		"@monti-cms/ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@monti-cms/admin": "workspace:*",
		"@monti-cms/ai": "workspace:*",
		"@tanstack/react-query": "^5.104.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jsdom": "^27.4.0",
		"next": "16.3.8",
		"next-auth": "5.0.0-beta.32",
		"next-themes": "^0.4.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"sonner": "^2.0.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"styles.css",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./admin": {
				"types": "./dist/admin.d.ts",
				"default": "./dist/admin.js"
			},
			"./styles.css": "./styles.css"
		}
	}
}
