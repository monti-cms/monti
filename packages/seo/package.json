{
	"name": "@monti-cms/seo",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's SEO plugin: search and share fields in a tab of their own, their preview in the editor, and seoOf for the site's pages.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"@monti-cms/admin": "workspace:*",
		"@monti-cms/core": "workspace:*",
		"@monti-cms/ui": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"kysely": "^0.29.6",
		"pg": "^8.23.0",
		"react": "^19.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.0.0"
	},
	"sideEffects": false,
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./admin": {
				"types": "./dist/admin.d.ts",
				"default": "./dist/admin.js"
			}
		}
	}
}
