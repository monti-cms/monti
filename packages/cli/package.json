{
	"name": "@monti-cms/cli",
	"version": "0.1.0-next.0",
	"private": true,
	"description": "Monti CLI: operation runner, production SQL migrations, and loose file cleanup",
	"license": "MIT",
	"type": "module",
	"bin": {
		"monti": "./src/bin.mjs"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"lint:deps": "depcruise --config .dependency-cruiser.cjs src",
		"lint:dup": "jscpd src",
		"lint:unused": "knip --no-config-hints",
		"test": "vitest run",
		"test:mutation": "stryker run"
	},
	"peerDependencies": {
		"@monti-cms/core": "workspace:*"
	},
	"dependencies": {
		"jiti": "^2.7.0",
		"kysely": "^0.29.8",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"vitest": "^5.1.0"
	}
}
