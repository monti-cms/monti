{
	"root": "sidebar",
	"elements": {
		"sidebarRailToggle": {
			"type": "SidebarRailToggle"
		},
		"sidebarHeader": {
			"type": "SidebarHeader",
			"children": ["sidebarRailToggle"]
		},
		"icon": {
			"type": "Icon",
			"props": {
				"name": "document"
			}
		},
		"sidebarItem": {
			"type": "SidebarItem",
			"props": {
				"active": true
			},
			"children": ["icon"]
		},
		"icon2": {
			"type": "Icon",
			"props": {
				"name": "pen"
			}
		},
		"sidebarItem2": {
			"type": "SidebarItem",
			"children": ["icon2"]
		},
		"icon3": {
			"type": "Icon",
			"props": {
				"name": "folder"
			}
		},
		"sidebarItem3": {
			"type": "SidebarItem",
			"children": ["icon3"]
		},
		"icon4": {
			"type": "Icon",
			"props": {
				"name": "tag"
			}
		},
		"sidebarItem4": {
			"type": "SidebarItem",
			"children": ["icon4"]
		},
		"icon5": {
			"type": "Icon",
			"props": {
				"name": "list"
			}
		},
		"sidebarItem5": {
			"type": "SidebarItem",
			"children": ["icon5"]
		},
		"icon6": {
			"type": "Icon",
			"props": {
				"name": "image"
			}
		},
		"sidebarItem6": {
			"type": "SidebarItem",
			"children": ["icon6"]
		},
		"sidebarNav": {
			"type": "SidebarNav",
			"props": {
				"place": "top"
			},
			"children": ["sidebarItem", "sidebarItem2", "sidebarItem3", "sidebarItem4", "sidebarItem5", "sidebarItem6"]
		},
		"icon7": {
			"type": "Icon",
			"props": {
				"name": "trash-can"
			}
		},
		"sidebarItem7": {
			"type": "SidebarItem",
			"children": ["icon7"]
		},
		"icon8": {
			"type": "Icon",
			"props": {
				"name": "tools"
			}
		},
		"changeDot": {
			"type": "ChangeDot"
		},
		"sidebarItem8": {
			"type": "SidebarItem",
			"children": ["icon8", "changeDot"]
		},
		"icon9": {
			"type": "Icon",
			"props": {
				"name": "settings--adjust"
			}
		},
		"sidebarItem9": {
			"type": "SidebarItem",
			"children": ["icon9"]
		},
		"sidebarScreenMode": {
			"type": "SidebarScreenMode",
			"props": {
				"value": "dark",
				"defaultOpen": true
			}
		},
		"sidebarFoot": {
			"type": "SidebarFoot",
			"children": ["sidebarScreenMode"]
		},
		"sidebarNav2": {
			"type": "SidebarNav",
			"props": {
				"place": "bottom"
			},
			"children": ["sidebarItem7", "sidebarItem8", "sidebarItem9", "sidebarFoot"]
		},
		"sidebar": {
			"type": "Sidebar",
			"props": {
				"rail": true
			},
			"children": ["sidebarHeader", "sidebarNav", "sidebarNav2"]
		}
	}
}
