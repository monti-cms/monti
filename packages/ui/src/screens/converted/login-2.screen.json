{
	"root": "stack",
	"elements": {
		"heading": {
			"type": "Heading",
			"props": {
				"as": "h1",
				"variant": "page"
			},
			"children": [
				{
					"state": "/drawn/text"
				}
			]
		},
		"formFieldLabel": {
			"type": "FormFieldLabel",
			"children": [
				{
					"text": "email"
				}
			],
			"props": {
				"for": "@input"
			}
		},
		"input": {
			"type": "Input",
			"props": {
				"type": "email"
			}
		},
		"formField": {
			"type": "FormField",
			"children": ["formFieldLabel", "input"]
		},
		"formFieldLabel2": {
			"type": "FormFieldLabel",
			"children": [
				{
					"text": "password"
				}
			],
			"props": {
				"for": "@input2"
			}
		},
		"input2": {
			"type": "Input",
			"props": {
				"type": "password",
				"invalid": true
			}
		},
		"formFieldError": {
			"type": "FormFieldError",
			"children": [
				{
					"text": "errorLocked"
				}
			]
		},
		"formField2": {
			"type": "FormField",
			"children": ["formFieldLabel2", "input2", "formFieldError"]
		},
		"button": {
			"type": "Button",
			"props": {
				"variant": "primary",
				"disabled": true
			},
			"children": [
				{
					"text": "signInSubmit"
				}
			]
		},
		"separator": {
			"type": "Separator",
			"props": {
				"label": {
					"text": "or"
				}
			}
		},
		"button2": {
			"type": "Button",
			"props": {
				"variant": "secondary"
			},
			"children": [
				{
					"state": "/drawn/text2"
				}
			]
		},
		"stack4": {
			"type": "Stack",
			"props": {
				"maxWidth": 360
			},
			"children": [
				"heading",
				{
					"spacing": 32
				},
				"formField",
				{
					"spacing": 24
				},
				"formField2",
				{
					"spacing": 12
				},
				"button",
				{
					"spacing": 20
				},
				"separator",
				{
					"spacing": 20
				},
				"button2"
			]
		},
		"stack3": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"align": "center",
				"justify": "center",
				"grow": true
			},
			"children": ["stack4"]
		},
		"text3": {
			"type": "Text",
			"props": {
				"as": "p",
				"variant": "micro",
				"tone": "faint",
				"align": "center"
			},
			"children": [
				{
					"state": "/drawn/text4"
				}
			]
		},
		"stack2": {
			"type": "Stack",
			"props": {
				"minHeight": "screen"
			},
			"children": [
				{
					"spacing": 48
				},
				"stack3",
				"text3",
				{
					"spacing": 24
				}
			]
		},
		"stack": {
			"type": "Stack",
			"props": {
				"direction": "row"
			},
			"children": [
				{
					"spacing": 16
				},
				"stack2",
				{
					"spacing": 16
				}
			]
		}
	}
}
