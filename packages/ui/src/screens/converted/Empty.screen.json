{
	"root": "stack",
	"overlays": ["assistantCorner"],
	"elements": {
		"siteName": {
			"type": "SiteName",
			"props": {
				"name": {
					"state": "/drawn/name"
				}
			}
		},
		"sidebarRailToggle": {
			"type": "SidebarRailToggle"
		},
		"sidebarHeader": {
			"type": "SidebarHeader",
			"children": ["siteName", "sidebarRailToggle"]
		},
		"icon": {
			"type": "Icon",
			"props": {
				"name": "document"
			}
		},
		"sidebarCount": {
			"type": "SidebarCount",
			"children": [
				{
					"state": "/drawn/text2"
				}
			]
		},
		"sidebarItem": {
			"type": "SidebarItem",
			"children": [
				"icon",
				{
					"state": "/drawn/text"
				},
				"sidebarCount"
			]
		},
		"icon2": {
			"type": "Icon",
			"props": {
				"name": "pen"
			}
		},
		"sidebarItem2": {
			"type": "SidebarItem",
			"props": {
				"active": true
			},
			"children": [
				"icon2",
				{
					"state": "/drawn/text3"
				}
			]
		},
		"icon3": {
			"type": "Icon",
			"props": {
				"name": "folder"
			}
		},
		"sidebarItem3": {
			"type": "SidebarItem",
			"children": [
				"icon3",
				{
					"state": "/drawn/text4"
				}
			]
		},
		"icon4": {
			"type": "Icon",
			"props": {
				"name": "tag"
			}
		},
		"sidebarItem4": {
			"type": "SidebarItem",
			"children": [
				"icon4",
				{
					"state": "/drawn/text5"
				}
			]
		},
		"icon5": {
			"type": "Icon",
			"props": {
				"name": "list"
			}
		},
		"sidebarItem5": {
			"type": "SidebarItem",
			"children": [
				"icon5",
				{
					"state": "/drawn/text6"
				}
			]
		},
		"icon6": {
			"type": "Icon",
			"props": {
				"name": "image"
			}
		},
		"sidebarItem6": {
			"type": "SidebarItem",
			"children": [
				"icon6",
				{
					"state": "/drawn/text7"
				}
			]
		},
		"sidebarNav": {
			"type": "SidebarNav",
			"props": {
				"place": "top"
			},
			"children": ["sidebarItem", "sidebarItem2", "sidebarItem3", "sidebarItem4", "sidebarItem5", "sidebarItem6"]
		},
		"icon7": {
			"type": "Icon",
			"props": {
				"name": "trash-can"
			}
		},
		"sidebarCount2": {
			"type": "SidebarCount",
			"children": [
				{
					"state": "/drawn/text9"
				}
			]
		},
		"sidebarItem7": {
			"type": "SidebarItem",
			"children": [
				"icon7",
				{
					"state": "/drawn/text8"
				},
				"sidebarCount2"
			]
		},
		"icon8": {
			"type": "Icon",
			"props": {
				"name": "tools"
			}
		},
		"sidebarCount3": {
			"type": "SidebarCount",
			"props": {
				"tone": "warning"
			},
			"children": [
				{
					"state": "/drawn/text11"
				}
			]
		},
		"sidebarItem8": {
			"type": "SidebarItem",
			"children": [
				"icon8",
				{
					"state": "/drawn/text10"
				},
				"sidebarCount3"
			]
		},
		"icon9": {
			"type": "Icon",
			"props": {
				"name": "settings--adjust"
			}
		},
		"sidebarItem9": {
			"type": "SidebarItem",
			"children": [
				"icon9",
				{
					"state": "/drawn/text12"
				}
			]
		},
		"sidebarScreenMode": {
			"type": "SidebarScreenMode",
			"props": {
				"value": "system"
			}
		},
		"sidebarFoot": {
			"type": "SidebarFoot",
			"children": ["sidebarScreenMode"]
		},
		"sidebarNav2": {
			"type": "SidebarNav",
			"props": {
				"place": "bottom"
			},
			"children": ["sidebarItem7", "sidebarItem8", "sidebarItem9", "sidebarFoot"]
		},
		"sidebar": {
			"type": "Sidebar",
			"children": ["sidebarHeader", "sidebarNav", "sidebarNav2"]
		},
		"stack3": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["sidebar"]
		},
		"stack2": {
			"type": "Stack",
			"children": ["stack3"]
		},
		"button": {
			"type": "Button",
			"props": {
				"variant": "primary"
			},
			"children": [
				{
					"state": "/drawn/text13"
				}
			]
		},
		"pageHeader": {
			"type": "PageHeader",
			"slots": {
				"title": [
					{
						"state": "/drawn/text14"
					}
				],
				"meta": [
					{
						"state": "/drawn/text15"
					}
				]
			},
			"children": ["button"]
		},
		"emptyHead": {
			"type": "EmptyHead",
			"props": {
				"title": {
					"state": "/drawn/text16"
				},
				"description": {
					"state": "/drawn/text17"
				}
			}
		},
		"emptyStep": {
			"type": "EmptyStep",
			"props": {
				"number": {
					"state": "/drawn/text18"
				},
				"title": {
					"state": "/drawn/text19"
				}
			}
		},
		"emptyStep2": {
			"type": "EmptyStep",
			"props": {
				"number": {
					"state": "/drawn/text20"
				},
				"title": {
					"state": "/drawn/text21"
				}
			}
		},
		"emptyStep3": {
			"type": "EmptyStep",
			"props": {
				"number": {
					"state": "/drawn/text22"
				},
				"title": {
					"state": "/drawn/text23"
				}
			}
		},
		"emptySteps": {
			"type": "EmptySteps",
			"children": ["emptyStep", "emptyStep2", "emptyStep3"]
		},
		"stack6": {
			"type": "Stack",
			"props": {
				"maxWidth": 880
			},
			"children": [
				"pageHeader",
				{
					"spacing": 48
				},
				"emptyHead",
				{
					"spacing": 32
				},
				"emptySteps"
			]
		},
		"stack5": {
			"type": "Stack",
			"props": {
				"align": "center",
				"grow": true
			},
			"children": [
				{
					"spacing": 40
				},
				"stack6",
				{
					"spacing": 48
				}
			]
		},
		"stack4": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"grow": true,
				"minWidth": 0
			},
			"children": [
				{
					"spacing": 48
				},
				"stack5",
				{
					"spacing": 48
				}
			]
		},
		"stack": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["stack2", "stack4"]
		},
		"assistantCorner": {
			"type": "AssistantCorner",
			"props": {
				"label": {
					"state": "/drawn/text24"
				}
			}
		}
	}
}
