{
	"root": "stack",
	"elements": {
		"icon": {
			"type": "Icon",
			"props": {
				"name": "chevron--left"
			}
		},
		"textButton": {
			"type": "TextButton",
			"props": {
				"variant": "quiet"
			},
			"children": [
				"icon",
				{
					"state": "/drawn/text"
				}
			]
		},
		"text2": {
			"type": "Text",
			"props": {
				"as": "span",
				"variant": "meta",
				"tone": "faint"
			},
			"children": [
				{
					"state": "/drawn/text3"
				}
			]
		},
		"entryStatus": {
			"type": "EntryStatus",
			"props": {
				"status": "draft"
			},
			"children": [
				{
					"state": "/drawn/text4"
				}
			]
		},
		"text6": {
			"type": "Text",
			"props": {
				"as": "span",
				"variant": "micro",
				"tone": "faint"
			},
			"children": [
				{
					"state": "/drawn/text7"
				}
			]
		},
		"textButton2": {
			"type": "TextButton",
			"children": [
				{
					"state": "/drawn/text5"
				},
				"text6"
			]
		},
		"button": {
			"type": "Button",
			"props": {
				"variant": "secondary"
			},
			"children": [
				{
					"state": "/drawn/text8"
				}
			]
		},
		"publishButton": {
			"type": "PublishButton",
			"props": {
				"label": {
					"state": "/drawn/text9"
				},
				"menuLabel": {
					"state": "/drawn/text10"
				}
			}
		},
		"iconOnlyButton": {
			"type": "IconOnlyButton",
			"props": {
				"icon": "right-panel--open"
			}
		},
		"moreButton": {
			"type": "MoreButton"
		},
		"stack3": {
			"type": "Stack",
			"props": {
				"direction": "row"
			},
			"children": ["moreButton"]
		},
		"verticalRule": {
			"type": "VerticalRule"
		},
		"iconOnlyButton2": {
			"type": "IconOnlyButton",
			"props": {
				"icon": "spark",
				"label": {
					"state": "/drawn/text11"
				}
			}
		},
		"editorTopBar": {
			"type": "EditorTopBar",
			"slots": {
				"start": ["textButton", "text2", "entryStatus"],
				"end": ["textButton2", "button", "publishButton", "iconOnlyButton", "stack3", "verticalRule", "iconOnlyButton2"]
			}
		},
		"editorBody": {
			"type": "EditorBody",
			"props": {
				"doc": {
					"state": "/drawn/doc"
				},
				"muted": true
			}
		},
		"sourceColumn": {
			"type": "SourceColumn",
			"props": {
				"label": {
					"state": "/drawn/text12"
				},
				"title": {
					"state": "/drawn/title"
				}
			},
			"children": ["editorBody"]
		},
		"stack5": {
			"type": "Stack",
			"props": {
				"grow": true,
				"minWidth": 0
			},
			"children": ["sourceColumn"]
		},
		"tab": {
			"type": "Tab",
			"props": {
				"label": {
					"state": "/drawn/text13"
				}
			}
		},
		"tab2": {
			"type": "Tab",
			"props": {
				"label": {
					"state": "/drawn/text14"
				},
				"current": true
			}
		},
		"tabAdd": {
			"type": "TabAdd",
			"props": {
				"label": {
					"state": "/drawn/text15"
				}
			}
		},
		"tabLinks": {
			"type": "TabLinks",
			"children": ["tab", "tab2", "tabAdd"]
		},
		"stack9": {
			"type": "Stack",
			"props": {
				"grow": true,
				"minWidth": 0
			},
			"children": ["tabLinks"]
		},
		"icon2": {
			"type": "Icon",
			"props": {
				"name": "spark"
			}
		},
		"textButton3": {
			"type": "TextButton",
			"props": {
				"tone": "proposal"
			},
			"children": [
				"icon2",
				{
					"state": "/drawn/text16"
				}
			]
		},
		"verticalRule2": {
			"type": "VerticalRule"
		},
		"text17": {
			"type": "Text",
			"props": {
				"variant": "note"
			},
			"children": [
				{
					"state": "/drawn/text18"
				}
			]
		},
		"segmentedChoice": {
			"type": "SegmentedChoice",
			"props": {
				"label": {
					"state": "/drawn/text19"
				},
				"options": {
					"state": "/drawn/options"
				},
				"picked": {
					"state": "/drawn/text20"
				},
				"size": "sm",
				"inline": true
			}
		},
		"languageBar": {
			"type": "LanguageBar",
			"slots": {
				"tabs": ["stack9"],
				"action": ["textButton3", "verticalRule2", "text17", "segmentedChoice"]
			}
		},
		"entryTitle": {
			"type": "EntryTitle",
			"props": {
				"text": {
					"state": "/drawn/text21"
				},
				"untranslated": true
			}
		},
		"titleRule": {
			"type": "TitleRule"
		},
		"editorBody2": {
			"type": "EditorBody",
			"props": {
				"doc": {
					"state": "/drawn/doc2"
				}
			}
		},
		"stack8": {
			"type": "Stack",
			"props": {
				"maxWidth": 680
			},
			"children": [
				"languageBar",
				{
					"spacing": 16
				},
				"entryTitle",
				{
					"spacing": 20
				},
				"titleRule",
				{
					"spacing": 32
				},
				"editorBody2"
			]
		},
		"stack7": {
			"type": "Stack",
			"props": {
				"align": "center",
				"grow": true
			},
			"children": [
				{
					"spacing": 16
				},
				"stack8",
				{
					"spacing": 48
				}
			]
		},
		"stack6": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"grow": true,
				"minWidth": 0
			},
			"children": [
				{
					"spacing": 48
				},
				"stack7",
				{
					"spacing": 48
				}
			]
		},
		"stack4": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"grow": true
			},
			"children": [
				"stack5",
				{
					"spacing": 40
				},
				"stack6"
			]
		},
		"statusCell": {
			"type": "StatusCell",
			"props": {
				"label": {
					"state": "/drawn/text22"
				}
			}
		},
		"statusCell2": {
			"type": "StatusCell",
			"props": {
				"label": {
					"state": "/drawn/text23"
				},
				"tone": "warning"
			}
		},
		"statusGap": {
			"type": "StatusGap"
		},
		"statusCell3": {
			"type": "StatusCell",
			"props": {
				"label": {
					"state": "/drawn/text24"
				},
				"end": true
			}
		},
		"editorStatusBar": {
			"type": "EditorStatusBar",
			"children": ["statusCell", "statusCell2", "statusGap", "statusCell3"]
		},
		"stack2": {
			"type": "Stack",
			"props": {
				"grow": true,
				"minWidth": 0
			},
			"children": ["editorTopBar", "stack4", "editorStatusBar"]
		},
		"stack": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["stack2"]
		}
	}
}
