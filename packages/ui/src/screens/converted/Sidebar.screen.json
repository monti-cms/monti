{
	"root": "stack",
	"elements": {
		"siteName": {
			"type": "SiteName",
			"props": {
				"name": {
					"state": "/drawn/name"
				}
			}
		},
		"sidebarRailToggle": {
			"type": "SidebarRailToggle"
		},
		"sidebarHeader": {
			"type": "SidebarHeader",
			"children": ["siteName", "sidebarRailToggle"]
		},
		"icon": {
			"type": "Icon",
			"props": {
				"name": "document"
			}
		},
		"sidebarCount": {
			"type": "SidebarCount",
			"children": [
				{
					"state": "/drawn/text2"
				}
			]
		},
		"sidebarItem": {
			"type": "SidebarItem",
			"props": {
				"active": true
			},
			"children": [
				"icon",
				{
					"state": "/drawn/text"
				},
				"sidebarCount"
			]
		},
		"count": {
			"type": "Count",
			"children": [
				{
					"state": "/drawn/text4"
				}
			]
		},
		"sidebarSubItem": {
			"type": "SidebarSubItem",
			"children": [
				{
					"state": "/drawn/text3"
				},
				"count"
			]
		},
		"sidebarSub": {
			"type": "SidebarSub",
			"children": ["sidebarSubItem"]
		},
		"icon2": {
			"type": "Icon",
			"props": {
				"name": "pen"
			}
		},
		"sidebarItem2": {
			"type": "SidebarItem",
			"children": [
				"icon2",
				{
					"state": "/drawn/text5"
				}
			]
		},
		"icon3": {
			"type": "Icon",
			"props": {
				"name": "folder"
			}
		},
		"sidebarItem3": {
			"type": "SidebarItem",
			"children": [
				"icon3",
				{
					"state": "/drawn/text6"
				}
			]
		},
		"icon4": {
			"type": "Icon",
			"props": {
				"name": "tag"
			}
		},
		"sidebarItem4": {
			"type": "SidebarItem",
			"children": [
				"icon4",
				{
					"state": "/drawn/text7"
				}
			]
		},
		"icon5": {
			"type": "Icon",
			"props": {
				"name": "list"
			}
		},
		"sidebarItem5": {
			"type": "SidebarItem",
			"children": [
				"icon5",
				{
					"state": "/drawn/text8"
				}
			]
		},
		"icon6": {
			"type": "Icon",
			"props": {
				"name": "image"
			}
		},
		"sidebarItem6": {
			"type": "SidebarItem",
			"children": [
				"icon6",
				{
					"state": "/drawn/text9"
				}
			]
		},
		"sidebarNav": {
			"type": "SidebarNav",
			"props": {
				"place": "top"
			},
			"children": [
				"sidebarItem",
				"sidebarSub",
				"sidebarItem2",
				"sidebarItem3",
				"sidebarItem4",
				"sidebarItem5",
				"sidebarItem6"
			]
		},
		"icon7": {
			"type": "Icon",
			"props": {
				"name": "trash-can"
			}
		},
		"sidebarCount2": {
			"type": "SidebarCount",
			"children": [
				{
					"state": "/drawn/text11"
				}
			]
		},
		"sidebarItem7": {
			"type": "SidebarItem",
			"children": [
				"icon7",
				{
					"state": "/drawn/text10"
				},
				"sidebarCount2"
			]
		},
		"icon8": {
			"type": "Icon",
			"props": {
				"name": "tools"
			}
		},
		"sidebarCount3": {
			"type": "SidebarCount",
			"props": {
				"tone": "warning"
			},
			"children": [
				{
					"state": "/drawn/text13"
				}
			]
		},
		"sidebarItem8": {
			"type": "SidebarItem",
			"children": [
				"icon8",
				{
					"state": "/drawn/text12"
				},
				"sidebarCount3"
			]
		},
		"icon9": {
			"type": "Icon",
			"props": {
				"name": "settings--adjust"
			}
		},
		"sidebarItem9": {
			"type": "SidebarItem",
			"children": [
				"icon9",
				{
					"state": "/drawn/text14"
				}
			]
		},
		"sidebarScreenMode": {
			"type": "SidebarScreenMode",
			"props": {
				"value": "system",
				"label": {
					"state": "/drawn/text15"
				},
				"system": {
					"state": "/drawn/text16"
				},
				"light": {
					"state": "/drawn/text17"
				},
				"dark": {
					"state": "/drawn/text18"
				}
			}
		},
		"sidebarFoot": {
			"type": "SidebarFoot",
			"children": ["sidebarScreenMode"]
		},
		"sidebarNav2": {
			"type": "SidebarNav",
			"props": {
				"place": "bottom"
			},
			"children": ["sidebarItem7", "sidebarItem8", "sidebarItem9", "sidebarFoot"]
		},
		"sidebar": {
			"type": "Sidebar",
			"children": ["sidebarHeader", "sidebarNav", "sidebarNav2"]
		},
		"stack": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["sidebar"]
		}
	}
}
