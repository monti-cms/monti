			"type": "ChangedLabel",
			"props": {
				"label": {
					"state": "/drawn/text32"
				},
				"undo": {
					"state": "/drawn/text33"
				},
				"proposal": true
			}
		},
		"selectBox": {
			"type": "SelectBox",
			"props": {
				"value": {
					"state": "/drawn/text34"
				},
				"proposal": true,
				"width": "full"
			}
		},
		"was2": {
			"type": "Was",
			"props": {
				"text": {
					"state": "/drawn/text35"
				}
			}
		},
		"formField4": {
			"type": "FormField",
			"children": ["changedLabel3", "selectBox", "was2"]
		},
		"text39": {
			"type": "Text",
			"props": {
				"mono": true
			},
			"children": [
				{
					"state": "/drawn/text40"
				}
			]
		},
		"text37": {
			"type": "Text",
			"props": {
				"variant": "label",
				"tone": "warning"
			},
			"children": [
				{
					"state": "/drawn/text38"
				},
				"text39",
				{
					"state": "/drawn/text41"
				}
			]
		},
		"readValue": {
			"type": "ReadValue",
			"props": {
				"label": {
					"state": "/drawn/text36"
				}
			},
			"children": ["text37"]
		},
		"section3": {
			"type": "Section",
			"props": {
				"last": true
			},
			"slots": {
				"title": [
					{
						"state": "/drawn/text42"
					}
				]
			},
			"children": ["formField4", "readValue"]
