		"formFieldLabel": {
			"type": "FormFieldLabel",
			"children": [
				{
					"state": "/drawn/text24"
				}
			],
			"props": {
				"for": "@input2"
			}
		},
		"input2": {
			"type": "Input",
			"props": {
				"value": {
					"state": "/drawn/value2"
				},
				"mono": true
			}
		},
		"formField2": {
			"type": "FormField",
			"children": ["formFieldLabel", "input2"]
		},
		"section": {
			"type": "Section",
			"slots": {
				"title": [
					{
						"state": "/drawn/text25"
					}
				]
			},
			"children": ["formField", "formField2"]
		},
		"changedLabel2": {
			"type": "ChangedLabel",
			"props": {
				"label": {
					"state": "/drawn/text26"
				},
				"undo": {
					"state": "/drawn/text27"
				},
				"proposal": true,
				"for": "@affixField"
			}
		},
		"affixField": {
			"type": "AffixField",
			"props": {
				"prefix": {
					"state": "/drawn/text28"
