			"type": "Stack",
			"props": {
				"grow": true,
				"maxWidth": 880
			},
			"children": ["pageHeader", "pageToolbar", "section", "section2", "section3"]
		},
		"stack5": {
			"type": "Stack",
			"props": {
				"align": "center",
				"grow": true
			},
			"children": [
				{
					"spacing": 40
				},
				"stack6"
			]
		},
		"stack4": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"grow": true,
				"minWidth": 0
			},
			"children": [
				{
					"spacing": 48
				},
				"stack5",
				{
					"spacing": 48
				}
			]
		},
		"stack": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["stack2", "stack4"]
		},
		"assistantCorner": {
			"type": "AssistantCorner",
			"props": {
				"label": {
					"state": "/drawn/text43"
				}
			}
		}
