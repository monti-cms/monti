			"type": "Sidebar",
			"children": ["sidebarHeader", "sidebarNav", "sidebarNav2"]
		},
		"stack3": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"minHeight": "screen"
			},
			"children": ["sidebar"]
		},
		"stack2": {
			"type": "Stack",
			"children": ["stack3"]
		},
		"saveGroup": {
			"type": "SaveGroup",
