{
	"root": "column",
	"elements": {
		"column": {
			"type": "PageColumn",
			"props": {
				"width": "list"
			},
			"children": ["header", "list", "footer"]
		},
		"header": {
			"type": "PageHeader",
			"slots": {
				"title": [
					{
						"text": "posts"
					}
				],
				"meta": [
					{
						"state": "/addressRule"
					}
				]
			},
			"children": ["addFolder", "search", "writeNew"]
		},
		"addFolder": {
			"type": "TextButton",
			"children": [
				{
					"text": "addFolder"
				}
			]
		},
		"search": {
			"type": "SearchToggle",
			"props": {
				"label": {
					"text": "search"
				},
				"aria-label": {
					"text": "search"
				},
				"targets": {
					"state": "/searchTargets"
				}
			}
		},
		"writeNew": {
			"type": "Button",
			"props": {
				"variant": "primary"
			},
			"children": [
				"addIcon",
				{
					"text": "writeNew"
				}
			]
		},
		"addIcon": {
			"type": "Icon",
			"props": {
				"name": "add"
			}
		},
		"list": {
			"type": "ListScroll",
			"children": ["table"]
		},
		"table": {
			"type": "Table",
			"props": {
				"container": "none"
			},
			"children": ["head", "body"]
		},
		"head": {
			"type": "ListHead",
			"props": {
				"columns": {
					"state": "/columns"
				}
			}
		},
		"body": {
			"type": "TableBody",
			"children": ["folderRow", "row"]
		},
		"folderRow": {
			"type": "TableRow",
			"repeat": {
				"state": "/folders"
			},
			"children": ["folderLead", "folderTitle", "folderGap1", "folderGap2", "folderGap3", "folderGap4", "folderEnd"]
		},
		"folderLead": {
			"type": "TableCell"
		},
		"folderTitle": {
			"type": "TableCell",
			"props": {
				"truncate": true
			},
			"children": ["folderName"]
		},
		"folderName": {
			"type": "RowTitle",
			"props": {
				"folder": true
			},
			"slots": {
				"title": ["folderLink"],
				"address": [
					{
						"template": "folderCount",
						"values": {
							"count": "$item.count"
						}
					}
				]
			}
		},
		"folderLink": {
			"type": "RowLink",
			"children": [
				{
					"item": "/name"
				}
			]
		},
		"folderEnd": {
			"type": "TableCell",
			"props": {
				"align": "end"
			},
			"children": ["folderActions"]
		},
		"folderActions": {
			"type": "RowActions",
			"children": ["folderMore"]
		},
		"folderMore": {
			"type": "IconButton",
			"props": {
				"label": {
					"text": "rowMenu"
				}
			},
			"children": ["folderMoreIcon"]
		},
		"folderMoreIcon": {
			"type": "Icon",
			"props": {
				"name": "more"
			}
		},
		"row": {
			"type": "TableRow",
			"repeat": {
				"state": "/rows"
			},
			"children": ["status", "title", "category", "tags", "locales", "updated", "end"]
		},
		"status": {
			"type": "TableCell",
			"children": ["check", "statusMark"]
		},
		"check": {
			"type": "RowCheck",
			"props": {
				"checked": false,
				"label": {
					"template": "pick",
					"values": {
						"title": "$item.title"
					}
				}
			}
		},
		"statusMark": {
			"type": "EntryStatus",
			"props": {
				"status": {
					"item": "/status"
				},
				"quiet": {
					"item": "/quiet"
				}
			},
			"children": [
				{
					"item": "/statusName"
				}
			]
		},
		"title": {
			"type": "TableCell",
			"children": ["titleLine"],
			"props": {
				"truncate": true
			}
		},
		"titleLine": {
			"type": "RowTitle",
			"slots": {
				"title": ["titleLink"],
				"address": [
					{
						"item": "/address"
					}
				]
			}
		},
		"titleLink": {
			"type": "RowLink",
			"children": [
				{
					"item": "/title"
				}
			]
		},
		"category": {
			"type": "TableCell",
			"children": ["categoryText"]
		},
		"categoryText": {
			"type": "Text",
			"props": {
				"variant": "note",
				"truncate": true
			},
			"children": [
				{
					"item": "/category"
				}
			]
		},
		"tags": {
			"type": "TableCell",
			"children": ["tagsText"]
		},
		"tagsText": {
			"type": "Text",
			"props": {
				"variant": "note",
				"truncate": true
			},
			"children": [
				{
					"item": "/tags"
				}
			]
		},
		"locales": {
			"type": "TableCell",
			"children": ["localesCount"]
		},
		"localesCount": {
			"type": "Count",
			"children": [
				{
					"item": "/locales"
				}
			]
		},
		"updated": {
			"type": "TableCell",
			"children": ["updatedCount"]
		},
		"updatedCount": {
			"type": "Count",
			"children": [
				{
					"item": "/updated"
				}
			]
		},
		"end": {
			"type": "TableCell",
			"props": {
				"align": "end"
			},
			"children": ["actions"]
		},
		"actions": {
			"type": "RowActions",
			"children": ["more"]
		},
		"more": {
			"type": "IconButton",
			"props": {
				"label": {
					"text": "rowMenu"
				}
			},
			"children": ["moreIcon"]
		},
		"moreIcon": {
			"type": "Icon",
			"props": {
				"name": "more"
			}
		},
		"footer": {
			"type": "ListFooter",
			"children": ["range", "pageSize", "pagerRow"]
		},
		"range": {
			"type": "Count",
			"children": [
				{
					"template": "range",
					"values": {
						"range": "$range",
						"total": "$total"
					}
				}
			]
		},
		"pageSize": {
			"type": "PageSizeMenu",
			"props": {
				"label": {
					"text": "pageSize"
				},
				"options": {
					"state": "/pageSizes"
				}
			},
			"bind": "/pageSize"
		},
		"pagerRow": {
			"type": "Stack",
			"props": {
				"direction": "row",
				"justify": "end",
				"grow": true
			},
			"children": ["pager"]
		},
		"pager": {
			"type": "Pagination",
			"children": ["pages"]
		},
		"pages": {
			"type": "PaginationContent",
			"children": ["previous", "page", "next"]
		},
		"previous": {
			"type": "PaginationItem",
			"children": ["previousLink"]
		},
		"previousLink": {
			"type": "PaginationPrevious",
			"props": {
				"disabled": {
					"state": "/previous/disabled"
				}
			}
		},
		"page": {
			"type": "PaginationItem",
			"repeat": {
				"state": "/pages"
			},
			"children": ["pageLink"]
		},
		"pageLink": {
			"type": "PaginationLink",
			"props": {
				"isActive": {
					"item": "/current"
				}
			},
			"children": [
				{
					"item": "/number"
				}
			]
		},
		"next": {
			"type": "PaginationItem",
			"children": ["nextLink"]
		},
		"nextLink": {
			"type": "PaginationNext"
		},
		"folderGap1": {
			"type": "TableCell"
		},
		"folderGap2": {
			"type": "TableCell"
		},
		"folderGap3": {
			"type": "TableCell"
		},
		"folderGap4": {
			"type": "TableCell"
		}
	}
}
