{
	"name": "@monti-cms/ui",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's design system: tokens and the components the admin and its extensions are built from",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./internal": "./src/internal.ts",
		"./theme.css": "./styles/theme.css",
		"./tokens.css": "./styles/tokens.css"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build -o storybook-static",
		"visual:run": "playwright test --config visual/playwright.config.ts",
		"test:visual": "pnpm build-storybook && pnpm visual:run",
		"test:visual:audit": "pnpm build-storybook && playwright test --config visual/audit.config.ts",
		"test:visual:update": "pnpm build-storybook && pnpm visual:run --update-snapshots"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"react-day-picker": "^10.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.4.0"
	},
	"peerDependencies": {
		"lucide-react": ">=0.562.0",
		"react": ">=19",
		"react-dom": ">=19"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@storybook/addon-themes": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jsdom": "^27.4.0",
		"lucide-react": "^0.562.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"storybook": "10.6.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"styles",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./internal": {
				"types": "./dist/internal.d.ts",
				"default": "./dist/internal.js"
			},
			"./theme.css": "./styles/theme.css",
			"./tokens.css": "./styles/tokens.css"
		}
	}
}
