{
	"name": "@monti-cms/ui",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's design system: tokens and the components the admin and its extensions are built from",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./icons": "./src/icons.ts",
		"./internal": "./src/internal.ts",
		"./spec": "./src/spec-pack/index.tsx",
		"./theme.css": "./styles/theme.css",
		"./tokens.css": "./styles/tokens.css"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build -o storybook-static",
		"test:browser": "vitest run --project 'ui (browser)'"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@carbon/icons-react": "11.90.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"react-day-picker": "^10.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.4.0"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@monti-cms/blocks": "workspace:*",
		"@storybook/addon-themes": "10.6.1",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^20",
		"@types/pngjs": "^6.0.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"katex": "^0.16.47",
		"mermaid": "^11.17.2",
		"pngjs": "7.0.0",
		"pretendard": "^1.3.9",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"storybook": "10.6.1",
		"storybook-addon-pseudo-states": "10.6.1",
		"typescript": "^7.0.2",
		"typescript-api": "npm:typescript@5.9.3",
		"vite": "^8.3.0",
		"vitest": "4.1.12"
	},
	"files": [
		"dist",
		"styles",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./icons": {
				"types": "./dist/icons.d.ts",
				"default": "./dist/icons.js"
			},
			"./internal": {
				"types": "./dist/internal.d.ts",
				"default": "./dist/internal.js"
			},
			"./spec": {
				"types": "./dist/spec-pack/index.d.ts",
				"default": "./dist/spec-pack/index.js"
			},
			"./theme.css": "./styles/theme.css",
			"./tokens.css": "./styles/tokens.css"
		}
	}
}
