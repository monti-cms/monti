{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/__test__/*.ts",
		"src/__test__/*.tsx",
		"src/__test__/migrations",
		"src/__test__/parity",
		"src/admin/*.test.*"
	]
}
