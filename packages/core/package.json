{
	"name": "@monti-cms/core",
	"version": "0.1.0",
	"private": true,
	"description": "DB-backed CMS core: config, schema, stores, the stored document, its renderer and plugins",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server/index.ts",
		"./client": "./src/client.ts",
		"./runtime": "./src/runtime.ts",
		"./read": "./src/read/index.ts",
		"./document": "./src/document.ts",
		"./notation": "./src/notation.ts",
		"./format": "./src/format/index.ts",
		"./code-block": "./src/code-block.ts",
		"./render/code": "./src/render/code/index.ts",
		"./render": "./src/render/index.tsx",
		"./plugin/server": "./src/plugin-server.ts",
		"./adapters/auth": "./src/adapters/auth/index.ts",
		"./testing": "./src/testing.ts",
		"./cli": "./src/cli/index.ts",
		"./import-boundary": "./src/cli/import-boundary.ts",
		"./schema-types": "./src/cli/schema-types.ts",
		"./schema-change": "./src/schema-change/index.ts",
		"./schema-edit": "./src/schema-edit/index.ts",
		"./schema.json": "./schema.json",
		"./stubs/missing-optional": "./stubs/missing-optional.cjs",
		"./render.css": "./render.css"
	},
	"bin": {
		"monti": "./bin/monti.mjs"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
		"test:other-site": "vitest run -c vitest.othersite.config.ts",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs",
		"schema:build": "tsx scripts/write-json-schema.ts"
	},
	"dependencies": {
		"@shikijs/langs": "^3.21.0",
