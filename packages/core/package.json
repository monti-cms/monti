{
	"name": "@monti-cms/core",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "DB-backed CMS core: config, schema, stores, the stored document, its renderer and plugins",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server/index.ts",
		"./site": "./src/site-entry.ts",
		"./read": "./src/read/index.ts",
		"./document": "./src/document.ts",
		"./notation": "./src/notation.ts",
		"./format": "./src/format/index.ts",
		"./front-matter": "./src/front-matter.ts",
		"./code-block": "./src/code-block.ts",
		"./render/code": "./src/render/code/index.ts",
		"./render": "./src/render/index.tsx",
		"./ai-contract": "./src/ai-contract.ts",
		"./adapters": "./src/adapters.ts",
		"./adapters/auth": "./src/adapters/auth/index.ts",
		"./testing": "./src/testing.ts",
		"./internal/cli": "./src/cli/index.ts",
		"./internal/import-boundary": "./src/cli/import-boundary.ts",
		"./internal/schema-change": "./src/schema-change/index.ts",
		"./internal/schema-edit": "./src/schema-edit/index.ts",
		"./internal/host": "./src/internal-host.ts",
		"./render.css": "./render.css"
	},
	"bin": {
		"monti": "./bin/monti.mjs"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run && vitest run -c vitest.othersite.config.ts",
		"test:other-site": "vitest run -c vitest.othersite.config.ts",
		"test:mutation": "stryker run",
		"test:mutation:score": "stryker run stryker.score.config.mjs",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@shikijs/langs": "^3.21.0",
		"@shikijs/themes": "^3.21.0",
		"@shikijs/transformers": "^3.22.0",
		"@types/hast": "^3.0.4",
		"@types/pg": "^8.23.1",
		"@types/unist": "^3.0.3",
		"github-slugger": "^2.0.0",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"katex": "^0.16.45",
		"kysely": "^0.29.6",
		"pg": "^8.23.0",
		"pluralize": "^8.0.0",
		"server-only": "^0.0.1",
		"shiki": "^3.21.0",
		"tsx": "^4.21.0",
		"unist-util-visit": "^5.0.0",
		"yaml": "^2.9.1",
		"zod": "^4.2.1"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/pluralize": "^0.0.33",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"ajv": "^8.20.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"render.css"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./server": {
				"types": "./dist/server/index.d.ts",
