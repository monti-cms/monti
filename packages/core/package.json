		"@shikijs/transformers": "^3.22.0",
		"@types/hast": "^3.0.4",
		"@types/pg": "^8.23.1",
		"@types/unist": "^3.0.3",
		"github-slugger": "^2.0.0",
		"hast-util-to-jsx-runtime": "^2.3.6",
		"katex": "^0.16.45",
		"kysely": "^0.29.6",
		"pg": "^8.23.0",
		"server-only": "^0.0.1",
		"shiki": "^3.21.0",
		"tsx": "^4.21.0",
		"unist-util-visit": "^5.0.0",
		"zod": "^4.2.1"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"ajv": "^8.20.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^4.0.18"
	},
	"files": [
