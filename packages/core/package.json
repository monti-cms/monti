{
	"name": "@monti-cms/core",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's core: operations, the engine that runs them, and the entry points they produce",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./cli": "./src/cli/main.ts",
		"./render": "./src/render.ts",
		"./code": "./src/code/index.ts",
		"./render.css": "./render.css"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"jiti": "^2.7.0",
		"kysely": "^0.29.6",
		"pg": "^8.23.0",
		"shiki": "^3.23.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@next/env": "16.4.6",
		"@types/node": "^20",
		"@types/pg": "^8.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.0.0"
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"render.css"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./cli": {
				"types": "./dist/cli/main.d.ts",
				"default": "./dist/cli/main.js"
			},
			"./render": {
				"types": "./dist/render.d.ts",
				"default": "./dist/render.js"
			},
			"./code": {
				"types": "./dist/code/index.d.ts",
				"default": "./dist/code/index.js"
			},
			"./render.css": "./render.css"
		}
	},
	"sideEffects": false,
	"bin": {
		"monti": "./bin/monti.mjs"
	}
}
