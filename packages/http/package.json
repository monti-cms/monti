		"test:mutation": "stryker run"
	},
	"peerDependencies": {
		"@monti-cms/core": "workspace:*"
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"kysely": "^0.29.8",
		"pg": "^8.23.1",
		"vitest": "^5.1.0",
		"zod": "^4.2.1"
	}
}
