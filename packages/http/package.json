{
	"name": "@monti-cms/http",
	"version": "0.1.0-next.0",
	"private": true,
	"description": "Monti HTTP: framework-agnostic Web Standard REST API handler and session cookie auth for @monti-cms/core",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
