{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["node", "next", "vitest/globals", "@testing-library/jest-dom"],
		"paths": {
			"@cms-config": ["../core/test/cms.config.ts"]
		}
	},
	"include": ["src", "vitest.config.ts"]
}
