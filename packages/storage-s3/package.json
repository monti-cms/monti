{
	"name": "@monti-cms/storage-s3",
	"version": "0.2.0-next.1",
	"private": true,
	"description": "Media storage for @monti-cms/core on the S3 API: AWS S3, Cloudflare R2 and MinIO, configured from conventional environment variables",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit -p .",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1136.0",
		"@aws-sdk/s3-request-presigner": "^3.1136.0"
	},
	"peerDependencies": {
		"@monti-cms/core": "workspace:^"
	},
	"devDependencies": {
		"@monti-cms/core": "workspace:*",
		"@types/node": "^20",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
