{
	"name": "@monti-cms/storage-s3",
	"version": "0.2.0-next.16",
	"private": true,
	"description": "Monti's media storage on S3 and what speaks its API (Cloudflare R2, MinIO): files go straight from the browser to the bucket.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"test": "vitest run",
		"build": "node ../../scripts/build-package.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1167.0",
		"@aws-sdk/s3-request-presigner": "^3.1167.0",
		"@monti-cms/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20",
		"typescript": "^7.0.2",
		"vitest": "^4.0.0"
	},
	"sideEffects": false,
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	}
}
