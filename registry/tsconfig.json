{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "esnext"],
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"types": ["node"],
		"paths": {
			"@/registry/monti/*": ["./items/*"],
			"@/cms.server": ["./typecheck/cms.server.ts"]
		}
	},
	"include": ["items", "typecheck"]
}
