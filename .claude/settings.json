{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-review.mjs\" --hook"
					},
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-scenes.mjs\" --hook"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-scenes.mjs\" --notice"
					}
				]
			}
		]
	}
}
