{
	"agent-guard": {
		"SessionStart": [
			{
				"type": "command",
				"command": "node \"$(git rev-parse --show-toplevel)/agent-guard/map.mjs\"",
				"timeout": 15
			}
		],
		"PreToolUse": [
			{
				"matcher": "write_to_file|replace_file_content|multi_replace_file_content",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/agent-guard/check.mjs\" --pre-tool",
						"timeout": 10
					}
				]
			}
		],
		"Stop": [
			{
				"type": "command",
				"command": "node \"$(git rev-parse --show-toplevel)/agent-guard/check.mjs\" --stop",
				"timeout": 180
			}
		]
	}
}
